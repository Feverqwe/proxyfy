{
  "name": "proxyfy",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "_clear": "del-cli ./dist",
    "_compress": "node ./builder/compressDist.mts --target ./dist/",
    "_build": "npm run _clear && rspack --config rspack.config.mts",
    "build": "npm run _build -- --mode development",
    "watch": "npm run _build -- --mode development --watch",
    "release": "npm run _build -- --mode production && npm run _compress",
    "storybook": "storybook dev -p 6006 --no-open --no-version-updates",
    "build-storybook": "storybook build",
    "tsc": "tsc --noEmit",
    "lint": "eslint . && npm run prettier && npm run typecheck",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "lint:fix": "eslint . --fix && npm run prettier:fix",
    "test": "vitest",
    "typecheck": "npm run tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Feverqwe/proxyfy.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Feverqwe/proxyfy/issues"
  },
  "homepage": "https://github.com/Feverqwe/proxyfy#readme",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/system": "^9.3.0",
    "escape-string-regexp": "^5.0.0",
    "final-form": "^5.0.1",
    "react": "^19.2.8",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.8",
    "react-final-form": "^7.0.1",
    "react-router": "^8.3.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@gravity-ui/eslint-config": "^4.3.2",
    "@gravity-ui/prettier-config": "^1.1.1",
    "@rspack/cli": "^2.1.10",
    "@rspack/core": "^2.1.10",
    "@storybook/react-vite": "^10.5.7",
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.2.6",
    "@types/offscreencanvas": "^2019.7.3",
    "@types/react": "^19.2.18",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.4",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.7",
    "style-loader": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}

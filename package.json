{
  "name": "proxyfy",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "_clear": "del-cli ./dist",
    "_compress": "ts-node ./builder/compressDist --target ./dist/",
    "_build": "npm run _clear && rspack --config rspack.config.ts",
    "build": "npm run _build -- --mode development",
    "watch": "npm run _build -- --mode development --watch",
    "release": "npm run _build -- --mode production && npm run _compress",
    "tsc": "tsc --noEmit",
    "lint": "npx eslint ./src && npm run prettier && npm run tsc",
    "prettier": "npx prettier --check ./src",
    "prettier:fix": "npx prettier --write ./src",
    "lint:fix": "npx eslint --fix ./src && npm run prettier:fix",
    "test": "vitest",
    "typecheck": "npm run tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Feverqwe/proxyfy.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Feverqwe/proxyfy/issues"
  },
  "homepage": "https://github.com/Feverqwe/proxyfy#readme",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/system": "^7.3.9",
    "escape-string-regexp": "^5.0.0",
    "react": "^19.2.4",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.2",
    "react-router-dom": "^7.13.2",
    "superstruct": "^2.0.2"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/chrome": "^0.1.38",
    "@types/offscreencanvas": "^2019.7.3",
    "@types/react": "^19.2.14",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "archiver": "^7.0.1",
    "@rspack/cli": "^1.7.10",
    "@rspack/core": "^1.7.10",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "del-cli": "^7.0.0",
    "eslint": "^10.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "style-loader": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "overrides": {
    "typescript": "^6.0.2"
  }
}

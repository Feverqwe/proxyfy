{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "noEmit": false,
    "target": "ES2017",
    "module": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "outDir": "./dist/",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": ["vitest/globals", "@types/chrome", "@types/react"]
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/**"]
}
